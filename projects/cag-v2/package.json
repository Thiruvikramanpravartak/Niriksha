{
  "name": "@projects/cag-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "cucumber-js --config cucumber.cjs",
    "test:e2e": "cucumber-js --config cucumber.cjs",

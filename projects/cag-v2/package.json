{
  "name": "@projects/cag-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/testRunner.ts",
    "test:e2e": "cross-env ENV=e2e tsx scripts/testRunner.ts",
    "test:uat": "cross-env ENV=uat tsx scripts/testRunner.ts",
    "test:smoke": "tsx scripts/testRunner.ts --tags \"@smoke and not @pending\"",
    "test:regression": "tsx scripts/testRunner.ts --tags \"@regression and not @pending\"",
    "validate:features": "tsx scripts/validateFeatures.ts",
    "traceability": "tsx scripts/traceability.ts",
    "check:e2e": "tsx scripts/checkE2eReadiness.ts",
    "check:uat": "tsx scripts/checkUatReadiness.ts",
    "show:report": "tsx scripts/openReport.ts"
  },
  "dependencies": {
    "@qa/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}

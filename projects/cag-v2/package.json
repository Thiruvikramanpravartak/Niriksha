    "validate:features": "tsx scripts/validateFeatures.ts",
    "traceability": "tsx scripts/traceability.ts",
    "check:e2e": "tsx scripts/checkE2eReadiness.ts"
  },
  "dependencies": {
    "@qa/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
